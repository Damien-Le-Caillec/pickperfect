# Copier en .env.production sur le serveur et remplir les valeurs
POSTGRES_USER=pickperfect
POSTGRES_PASSWORD=
POSTGRES_DB=pickperfect

# Clé de signature des liens de confirmation d email (openssl rand -hex 32)
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://votre-domaine.fr

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PickPerfect <contact@votre-domaine.fr>"

# Secret partagé avec le conteneur cron (générer avec : openssl rand -hex 32)
CRON_SECRET=

# Affiliation (optionnel)
AMAZON_AFFILIATE_TAG=
FNAC_AFFILIATE_ID=
DARTY_PARTNER_ID=
# Deeplinks Awin / Effiliation : {url} est remplacé par l'URL du produit
AMAZON_AFFILIATE_TEMPLATE=
FNAC_AFFILIATE_TEMPLATE=
DARTY_AFFILIATE_TEMPLATE=
CDISCOUNT_AFFILIATE_TEMPLATE=
ETSY_AFFILIATE_TEMPLATE=
MANOMANO_AFFILIATE_TEMPLATE=
