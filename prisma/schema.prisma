generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ UTILISATEURS ============
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  username       String?   @unique
  hashedPassword String
  avatar         String?
  role           String    @default("USER")
  emailVerified  Boolean   @default(false)
  banned         Boolean   @default(false)
  lastLoginAt    DateTime?
  loginCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  emailNotifications Boolean @default(true)
  unsubscribeToken String? @unique

  sessions        Session[]
  lists           List[]
  reservations    Reservation[]
  reservedItems   Item[]             @relation("ItemReservedBy")
  points          Points?
  activityLogs    ActivityLog[]
  pointTxns       PointTransaction[]
  badges          UserBadge[]
  listGroupsAdded ListGroup[]        @relation("ListGroupAddedBy")
  resetTokens     PasswordResetToken[]
  groups          UserGroup[]
  listMemberships ListMember[]
  itemsCreated    Item[]       @relation("ItemCreatedBy")
  comments Comment[]
  notifications Notification[]
  friendshipsSent     Friendship[]  @relation("FriendshipSender")
  friendshipsReceived Friendship[]  @relation("FriendshipReceiver")
  itemActivities      ItemActivity[]
  birthdays            Birthday[]
  secretSantasGiving   SecretSantaAssign[] @relation("SecretSantaGiver")
  secretSantasReceiving SecretSantaAssign[] @relation("SecretSantaReceiver")
  contributions        Contribution[]
  weeklyChallenges WeeklyChallenge[]

  @@map("users")
}

// ============ SESSIONS ============
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

// ============ RESET MOT DE PASSE ============
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@map("password_reset_tokens")
}

// ============ LISTES ============
model List {
  id          String    @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacy     String    @default("UNLISTED")
  eventDate   DateTime?
  budget      Float?
  viewCount   Int       @default(0)
  shareCount  Int       @default(0)
  shareToken  String?   @unique
  collaborative Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  surpriseMode Boolean @default(false)

  items        Item[]
  groups       ListGroup[]
  activityLogs ActivityLog[]
  members      ListMember[]
  inviteTokens InviteToken[]
  views ListView[]
  comments Comment[] @relation("ListComments")

  @@index([userId])
  @@map("lists")
}

// ============ ITEMS ============
model Item {
  id              String    @id @default(cuid())
  listId          String
  list            List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  price           Float?
  currency        String    @default("EUR")
  url             String?
  imageUrl        String?
  affiliateLink   String?
  affiliateId     String?
  commissionRate  Float?
  reserved        Boolean   @default(false)
  reservedById    String?
  reservedBy      User?     @relation("ItemReservedBy", fields: [reservedById], references: [id])
  reservedAt      DateTime?
  priority        Int       @default(0)
  createdById     String?
  createdBy_item  User?     @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  receivedAt DateTime?
  receivedNote String?

  reservations Reservation[]
  comments Comment[]
  activities ItemActivity[]
  contributions Contribution[]

  @@index([listId])
  @@map("items")
}

// Commentaires
model Comment {
  id        String   @id @default(cuid())
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  listId    String?
  list      List?    @relation("ListComments", fields: [listId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("comments")
}

// Notification

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  message String
  link String?
  read Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("FriendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String @default("PENDING")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("friendships")
}

model ItemActivity {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "ADDED" | "EDITED" | "RESERVED" | "UNRESERVED"
  details   String?  // JSON des champs modifiés
  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("item_activities")
}

model Birthday {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String    // Prénom de la personne
  date         DateTime  // Mois + jour (l'année est ignorée pour le calcul)
  relatedListId String?  // Lien optionnel vers une liste
  remindDays   Int       @default(7) // Rappel X jours avant
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("birthdays")
}

model SecretSanta {
  id          String              @id @default(cuid())
  groupId     String              @unique
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  year        Int
  budget      Float?
  status      String @default("PENDING")
  assignments SecretSantaAssign[]
  createdAt   DateTime            @default(now())
  eventDate     DateTime?
  launchedAt    DateTime?
  lastReminderAt DateTime?

  @@map("secret_santas")
}

model SecretSantaAssign {
  id            String      @id @default(cuid())
  secretSantaId String
  secretSanta   SecretSanta @relation(fields: [secretSantaId], references: [id], onDelete: Cascade)
  giverId       String
  giver         User        @relation("SecretSantaGiver",    fields: [giverId],    references: [id])
  receiverId    String
  receiver      User        @relation("SecretSantaReceiver", fields: [receiverId], references: [id])
  wishedFilledAt DateTime?

  wishes SecretSantaWish[]
  @@unique([secretSantaId, giverId])
  @@map("secret_santa_assignments")
}

model SecretSantaWish {
  id            String   @id @default(cuid())
  assignId      String
  assign        SecretSantaAssign @relation(fields: [assignId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  price         Float?
  url           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("secret_santa_wishes")
}

model Contribution {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  message     String?
  createdAt   DateTime @default(now())

  @@unique([itemId, userId])
  @@map("contributions")
}

// ============ RÉSERVATIONS ============
model Reservation {
  id         String    @id @default(cuid())
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String?
  anonymous  Boolean   @default(false)
  status     String    @default("CONFIRMED")
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?
  receivedNote String?

  @@index([itemId])
  @@index([userId])
  @@map("reservations")
}

// ============ GROUPES ============
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  privacy     String   @default("PRIVATE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members UserGroup[]
  lists   ListGroup[]
  inviteTokens GroupInviteToken[]
  secretSanta SecretSanta?
  
  @@map("groups")
}

model UserGroup {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
  @@map("user_groups")
}

model ListGroup {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())
  addedById String
  addedBy   User     @relation("ListGroupAddedBy", fields: [addedById], references: [id])

  @@unique([listId, groupId])
  @@map("list_groups")
}

model GroupInviteToken {
  id String @id @default(cuid())
  groupId String
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  token String @unique
  createdBy String
  usedCount Int @default(0)
  maxUses Int @default(50)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("group_invite_tokens")
}

// ============ MEMBRES D'UNE LISTE ============
// Gère les accès individuels (invitation par email)
model ListMember {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // VIEWER  → peut voir la liste
  // EDITOR  → peut voir + ajouter/modifier des items
  role      String   @default("VIEWER")
  invitedAt DateTime @default(now())
  invitedBy String   // userId de celui qui a invité

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
  @@map("list_members")
}

// ============ TOKENS D'INVITATION ============
// Lien d'invitation envoyé par email ou copié
model InviteToken {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  token     String   @unique
  role      String   @default("VIEWER")
  createdBy String   // userId du créateur
  usedCount Int      @default(0)
  maxUses   Int      @default(50) // 0 = illimité
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("invite_tokens")
}

// ============ GAMIFICATION ============
model Points {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints     Int       @default(0)
  availablePoints Int       @default(0)
  spentPoints     Int       @default(0)
  level           Int       @default(1)
  experience      Int       @default(0)
  nextLevelExp    Int       @default(100)
  lastDailyLogin  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  currentStreak Int      @default(0)
  longestStreak Int      @default(0) 

  @@map("user_points")
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  points    Int
  reason    String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("point_transactions")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badgeName   String
  description String?
  earnedAt    DateTime @default(now())

  @@map("user_badges")
}

// ============ LOGS ============
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId    String?
  list      List?    @relation(fields: [listId], references: [id])
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("activity_logs")
}

model ListView {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String?  // null si non connecté (on compte quand même)
  ipAddress String?
  createdAt DateTime @default(now())

  @@unique([listId, userId])   // un seul enregistrement par user+liste
  @@index([listId])
  @@map("list_views")
}

model WeeklyChallenge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime // Lundi de la semaine
  challengeId String   // "reserve_3" | "share_list" | "add_5_items" | etc.
  progress    Int      @default(0)
  target      Int
  completed   Boolean  @default(false)
  rewardPts   Int
  createdAt   DateTime @default(now())

  @@unique([userId, weekStart, challengeId])
  @@map("weekly_challenges")
}